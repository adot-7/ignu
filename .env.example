# --- LLM (Anthropic only; total day budget $7.50) ---
ANTHROPIC_API_KEY=
LLM_MODEL_BATCH=claude-haiku-4-5          # profile synthesis, team "why" lines; verify id via GET /v1/models
LLM_MODEL_AGENT=claude-sonnet-5           # chat agent only (few calls)
LLM_BUDGET_USD=6.0                        # hard stop; leaves $1.50 headroom for the live demo
LLM_PRICE_TABLE=claude-haiku-4-5:1.0:5.0,claude-sonnet-5:3.0:15.0   # model:in_per_MTok:out_per_MTok (USD)

# --- Data ---
DATABASE_URL=sqlite:///data/ignu.db
REGISTRATIONS_FILE=data/private/registrations.xlsx
MAPPING_FILE=mapping.yaml
SCORING_FILE=scoring.yaml
CACHE_DIR=data/cache
EVENT_NAME=ignite-with-delhi-2026
PREV_EVENT_FILE=data/private/prev_event.csv    # optional: previous hackathon registrations + check-in

# --- GitHub evidence ---
GITHUB_TOKEN=                              # classic PAT, public_repo scope; 5000 req/h
GITHUB_MAX_REPOS_PER_PERSON=3
GITHUB_README_MAX_CHARS=4000

# --- Graph (Neo4j Aura Free) ---
GRAPH_ENABLED=true
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Memory (organizer notes) ---
MEMORY_BACKEND=sqlite                     # sqlite | cognee  (switch to cognee only after the spike passes)
# Cognee reads these itself (set BEFORE import cognee):
LLM_PROVIDER=anthropic
LLM_MODEL=anthropic/claude-haiku-4-5
LLM_API_KEY=${ANTHROPIC_API_KEY}
EMBEDDING_PROVIDER=fastembed              # local embeddings; no OpenAI key available. Verify in issue #9 spike.
GRAPH_DATABASE_PROVIDER=neo4j
GRAPH_DATABASE_URL=${NEO4J_URI}
GRAPH_DATABASE_USERNAME=${NEO4J_USERNAME}
GRAPH_DATABASE_PASSWORD=${NEO4J_PASSWORD}
ENABLE_BACKEND_ACCESS_CONTROL=false

# --- Channels ---
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
PUBLIC_BASE_URL=                          # cloudflared/ngrok URL for Slack, or https://ignu.akashparashar.dev

# --- Render Workflows (optional lane) ---
RENDER_API_KEY=
RENDER_WORKFLOW_SLUG=ignu-workflows
WORKFLOW_RUNNER=local                     # local | render
